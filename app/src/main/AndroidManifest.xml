<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used for the optional, encrypted Google Drive backup. Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Gentle haptic ticks during paced breathing (optional, off by switch). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- No ads, no advertising id: make sure no library brings it back. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Only to check whether Stagira is installed, for the optional "record in Stagira". -->
    <queries>
        <intent>
            <action android:name="cc.toolcrate.stagira.action.RECORD_URGE" />
        </intent>
    </queries>

    <application
        android:name=".KairosApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kairos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kairos.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!--
            Panic help: its own task so it can open over the lock screen without
            bringing the rest of the app (or the app lock) along. Never locked.
        -->
        <activity
            android:name=".panic.PanicActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="cc.toolcrate.kairos.panic"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Kairos.Panic" />

        <!-- Quick Settings tile; usable from the lock screen. -->
        <service
            android:name=".entry.KairosTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <receiver
            android:name=".entry.KairosWidgetReceiver"
            android:exported="true"
            android:label="Kairos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kairos_widget_info" />
        </receiver>
    </application>
</manifest>
